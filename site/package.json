{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap && node scripts/generate-llms.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@react-three/fiber": "9.8.2",
    "gray-matter": "4.0.3",
    "next": "16.3.1",
    "next-mdx-remote": "5.0.0",
    "next-sitemap": "4.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "react-syntax-highlighter": "16.1.1",
    "remark-gfm": "4.0.1",
    "three": "0.187.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
